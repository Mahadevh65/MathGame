# Copy this file's values into your shell/IDE run config, or into a .env
# loader of your choice — Spring Boot reads these as environment variables.

# JWT signing secret (32+ bytes recommended for HS256)
JWT_SECRET=change-me-to-a-long-random-string

# Allowed CORS origin(s) for the frontend, comma-separated
CORS_ORIGINS=http://localhost:5173

# --- Only needed if you switch application.yml from H2 to Supabase Postgres ---
# Found in Supabase: Project Settings -> Database -> Connection string (URI)
SUPABASE_DB_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password
